<Window x:Class="Fd2.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="용의기사2 편집기" Width="1180" Height="760"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <!-- 원본 그림은 작은 도트라 점 그대로 키운다 -->
        <Style TargetType="Image">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#2A2A2A" Geometry="M0,0 L2,0 2,2 0,2Z" />
                    <GeometryDrawing Brush="#333333" Geometry="M0,0 L1,0 1,1 0,1Z M1,1 L2,1 2,2 1,2Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="게임 폴더 열기(_O)..." Click="OnOpenFolder" />
                <MenuItem x:Name="VersionMenu" Header="버전 고르기(_V)" SubmenuOpened="OnVersionMenuOpened">
                    <MenuItem Header="(찾는 중…)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="끝내기(_X)" Click="OnExit" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="Status" />
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="4">
            <!-- 맵 캐릭터: FDICON.B24 의 12장(아래 · 왼쪽 · 위 · 오른쪽 × 걸음 3장) -->
            <TabItem Header="맵 캐릭터 (앞 · 뒤 · 옆)">
                <DockPanel>
                    <ListBox x:Name="IconList" DockPanel.Dock="Left" Width="190" SelectionChanged="OnIconSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Thumb}" Width="48" Height="48" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="16,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox x:Name="WalkAnim" Content="걷기 움직임" IsChecked="True" VerticalAlignment="Center" />
                            <TextBlock Text="  배율" VerticalAlignment="Center" Margin="16,0,4,0" />
                            <ComboBox x:Name="IconZoom" Width="70" SelectedIndex="2" SelectionChanged="OnIconZoomChanged">
                                <ComboBoxItem>2배</ComboBoxItem>
                                <ComboBoxItem>3배</ComboBoxItem>
                                <ComboBoxItem>4배</ComboBoxItem>
                                <ComboBoxItem>6배</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <!-- 네 방향을 나란히 — 앞(아래) · 뒤(위) · 왼옆 · 오른옆 -->
                        <ItemsControl x:Name="Facings">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,16,0">
                                        <Border Background="{StaticResource Checker}" BorderBrush="#555" BorderThickness="1">
                                            <Image Source="{Binding Image}" Width="{Binding Size}" Height="{Binding Size}" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="12장 전부 (번호 = FDICON 안의 차례)" Margin="0,20,0,4" Foreground="Gray" />
                        <ItemsControl x:Name="AllFrames">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,6,6">
                                        <Border Background="{StaticResource Checker}">
                                            <Image Source="{Binding Image}" Width="72" Height="72" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </TabItem>

            <!-- 전투 모션: FIGANI.DAT 3c(서기) · 3c+1(공격) — 한 컷씩 넘겨 본다 -->
            <TabItem Header="전투 모션 (한 컷씩)">
                <DockPanel>
                    <ListBox x:Name="MotionList" DockPanel.Dock="Left" Width="190" SelectionChanged="OnMotionCharSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Thumb}" Width="48" Height="48" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8">
                        <RadioButton x:Name="KindStand" Content="서기" GroupName="kind" Checked="OnKindChanged" VerticalAlignment="Center" />
                        <RadioButton x:Name="KindAttack" Content="공격" GroupName="kind" IsChecked="True" Checked="OnKindChanged" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <Button Content="◀ 이전 컷" Click="OnPrevFrame" Margin="24,0,0,0" Padding="10,2" />
                        <Button x:Name="PlayButton" Content="▶ 재생" Click="OnPlay" Margin="6,0,0,0" Padding="10,2" />
                        <Button Content="다음 컷 ▶" Click="OnNextFrame" Margin="6,0,0,0" Padding="10,2" />
                        <TextBlock Text="틱(ms)" VerticalAlignment="Center" Margin="16,0,4,0" />
                        <TextBox x:Name="TickMs" Text="55" Width="40" VerticalContentAlignment="Center" />
                        <CheckBox x:Name="Onion" Content="앞 컷 겹쳐 보기" Margin="16,0,0,0" VerticalAlignment="Center" Checked="OnOnionChanged" Unchecked="OnOnionChanged" />
                        <CheckBox x:Name="ShowBox" Content="그림 테두리" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OnOnionChanged" Unchecked="OnOnionChanged" />
                    </StackPanel>
                    <!-- 버전마다 뽑아 둔 .obs(모션\버전\캐릭터) — 이 캐릭터는 어느 버전 모션으로 돌지 -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,8">
                        <TextBlock Text="이 캐릭터 모션 버전" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="MotionVersion" Width="300" SelectionChanged="OnMotionVersionChanged" />
                        <Button Content="모든 버전 모션 .obs 다시 뽑기" Click="OnExportMotions" Margin="12,0,0,0" Padding="10,2" />
                        <Button Content="모션 폴더 열기" Click="OnOpenMotionFolder" Margin="6,0,0,0" Padding="10,2" />
                    </StackPanel>
                    <Slider x:Name="FrameSlider" DockPanel.Dock="Top" Margin="12,0" Minimum="0" IsSnapToTickEnabled="True"
                            TickFrequency="1" TickPlacement="BottomRight" ValueChanged="OnFrameSlider" />
                    <TextBlock x:Name="FrameInfo" DockPanel.Dock="Top" Margin="12,6" FontFamily="Consolas" FontSize="14" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource Checker}" HorizontalAlignment="Left" Margin="12,0">
                                <Image x:Name="MotionImage" Width="640" Height="400" />
                            </Border>
                            <TextBlock Text="모든 컷 (누르면 그 컷으로)" Margin="12,12,0,4" Foreground="Gray" />
                            <ItemsControl x:Name="MotionStrip" Margin="12,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Index}" Click="OnStripClick" Margin="0,0,4,4" Padding="0" Background="Transparent">
                                            <StackPanel>
                                                <Border Background="{StaticResource Checker}">
                                                    <Image Source="{Binding Image}" Width="160" Height="100" />
                                                </Border>
                                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <!-- 배경음악: FDMUS.DAT 의 곡들을 MIDI 로 바꿔 듣기 · 저장 -->
            <!-- 능력치: FD2.EXE 의 동료 꼴 · 성장표(아군), 몬스터 표(적) — 칸을 고쳐 저장(처음엔 FD2-backup.EXE 를 남김) -->
            <TabItem Header="능력치 · 물건 · 마법 · 상점">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="표" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="StatKind" Width="300" SelectionChanged="OnStatTableChanged" SelectedIndex="0">
                            <ComboBoxItem Content="아군 (동료 꼴 · 레벨업 성장)" />
                            <ComboBoxItem Content="적 (몬스터 — 능력은 레벨당 값)" />
                            <ComboBoxItem Content="물건 (215개)" />
                            <ComboBoxItem Content="마법 (36개)" />
                            <ComboBoxItem Content="상점 (장마다 무기 · 도구 · 비밀, 255 = 빈 칸)" />
                        </ComboBox>
                        <Button Content="고른 줄 비우기(삭제)" Click="OnStatClearRow" Margin="12,0,0,0" Padding="10,2" />
                        <Button Content="FD2.EXE 에 저장" Click="OnStatSave" Margin="24,0,0,0" Padding="14,2" />
                        <Button Content="되돌리기 (파일에서 다시 읽기)" Click="OnStatReload" Margin="8,0,0,0" Padding="10,2" />
                    </StackPanel>
                    <DataGrid x:Name="StatGrid" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              HeadersVisibility="Column" FrozenColumnCount="1" CellEditEnding="OnStatCellEdit" AutoGeneratingColumn="OnStatColumn" />
                </DockPanel>
            </TabItem>
            <!-- 이벤트: 장마다 시작 연출 · 사건 줄 · 땅 칸 사건 · 사건 상자 · 승리 뒤 연출(SceneEvents.json 대본 + 장면 정보) -->
            <TabItem Header="이벤트">
                <DockPanel Margin="8">
                    <ListBox x:Name="EventScenes" DockPanel.Dock="Left" Width="120" SelectionChanged="OnEventSceneSelected" />
                    <TextBox x:Name="EventText" Margin="8,0,0,0" IsReadOnly="True" FontFamily="Consolas, 맑은 고딕" FontSize="13" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>
            <TabItem Header="배경음악">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="▶ 듣기" Click="OnMusicPlay" Padding="14,2" />
                        <Button Content="■ 멈춤" Click="OnMusicStop" Margin="8,0,0,0" Padding="14,2" />
                        <CheckBox x:Name="MusicLoop" Content="되풀이" IsChecked="True" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <Button Content="MIDI 파일로 저장..." Click="OnMusicSave" Margin="16,0,0,0" Padding="10,2" />
                        <TextBlock x:Name="MusicNow" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#555"
                               Text="두 번 누르거나 Enter = 듣기, Esc = 멈춤. 지금 게임은 프롤로그 1막에 10번, 2막에 11번, 3막에 4번 곡을 씁니다. 소리는 윈도우 기본 MIDI 신시사이저로 나옵니다(원작의 애드립 · 사운드블래스터 소리와는 다릅니다)." />
                    <ListView x:Name="MusicList" MouseDoubleClick="OnMusicPlay" KeyDown="OnMusicListKey">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="곡" DisplayMemberBinding="{Binding Index}" Width="50" />
                                <GridViewColumn Header="길이" DisplayMemberBinding="{Binding Length}" Width="70" />
                                <GridViewColumn Header="악기" DisplayMemberBinding="{Binding Instruments}" Width="700" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <!-- 여러 판: 기준 판과 비교 판의 다른 파일 · DAT 안 바뀐 항목, 고른 파일만 비교 판 것으로 바꿔 새 폴더로 합치기 -->
            <TabItem Header="버전 비교 · 합치기">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="기준 버전" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="BaseVersion" Width="320" DisplayMemberPath="Label" />
                        <TextBlock Text="비교 버전" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <ComboBox x:Name="OtherVersion" Width="320" DisplayMemberPath="Label" />
                        <Button Content="비교" Click="OnCompare" Margin="12,0,0,0" Padding="14,2" />
                        <Button Content="버전 폴더 더하기..." Click="OnAddVersion" Margin="8,0,0,0" Padding="10,2" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="체크한 파일은 비교 버전 것으로, 나머지는 기준 버전 것으로 — 새 버전 이름" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="MergeName" Width="220" Text="용의기사2 합본" VerticalContentAlignment="Center" />
                        <Button Content="합치기 (새 폴더로)" Click="OnMerge" Margin="8,0,0,0" Padding="14,2" />
                    </StackPanel>
                    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DiffGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="OnDiffSelected">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="비교 버전 것" Binding="{Binding UseOther, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="파일" Binding="{Binding File}" IsReadOnly="True" Width="140" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" IsReadOnly="True" Width="100" />
                            <DataGridTextColumn Header="바뀐 항목(DAT 안 번호)" Binding="{Binding Entries}" IsReadOnly="True" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#DDD" />
                    <TextBox x:Name="DiffDetail" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas, 맑은 고딕" FontSize="13" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="위에서 파일을 고르면 무엇이 다른지 자세히 보입니다(모션은 컷마다, FD2.EXE 는 수치 표 칸마다)." />
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
